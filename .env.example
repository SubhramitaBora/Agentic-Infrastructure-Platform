# Jira Cloud. Set a site URL, not an issue's /browse/... URL.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=replace-with-your-atlassian-api-token
JIRA_PROJECT_KEY=AD

# Optional overrides. Confluence defaults to JIRA_BASE_URL and JIRA_EMAIL.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=

# GitHub integration.
GITHUB_TOKEN=replace-with-a-github-token
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-repository

# Choose the model provider used by app.chat and FastAPI: hydra or groq.
LLM_PROVIDER=hydra

# OpenAI-compatible LiteLLM endpoint for the Hydra model server.
# Use a URL reachable from the computer running this project, usually ending in /v1.
HYDRA_LITELLM_BASE_URL=http://hydra-host:4000/v1
# This is the model alias served by Hydra/LiteLLM, not necessarily the upstream model ID.
HYDRA_MODEL=your-hydra-model-alias
# Leave empty if the LiteLLM proxy does not require a client key.
HYDRA_API_KEY=
HYDRA_TIMEOUT=120

# Used when LLM_PROVIDER=groq, and by the standalone Groq smoke script.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
